# ---- Core ----
DATABASE_URL=postgres://stratum:stratum@localhost:5432/stratum
STRATUM_API_PORT=8788
STRATUM_DASHBOARD_PORT=8787
STRATUM_REALTIME_PORT=8789
NODE_ENV=development

# ---- API keys (generate with: stratum keys generate) ----
# Public key ships to browsers. Secret key is server-only. Never commit real values.
STRATUM_PUBLIC_KEY=strat_public_replace_me
STRATUM_SECRET_KEY=strat_secret_replace_me

# ---- Storage ----
# local | s3
STORAGE_DRIVER=local
STORAGE_PATH=./storage-data
STORAGE_MAX_UPLOAD_BYTES=104857600

# ---- S3 / Cloudflare R2 (only when STORAGE_DRIVER=s3) ----
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# ---- Security ----
CORS_ORIGINS=http://localhost:8787
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
MAX_REQUEST_BYTES=2097152

# ---- Dashboard (client-side) ----
NEXT_PUBLIC_STRATUM_URL=http://localhost:8788
