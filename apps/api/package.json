{
  "name": "@stratum/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts --format esm --clean --target node20",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stratum/shared": "workspace:*",
    "@stratum/config": "workspace:*",
    "@stratum/database": "workspace:*",
    "@stratum/storage": "workspace:*",
    "@stratum/realtime": "workspace:*",
    "@stratum/functions": "workspace:*",
    "@hono/node-server": "^1.13.2",
    "hono": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "embedded-postgres": "17.4.0-beta.15"
  }
}